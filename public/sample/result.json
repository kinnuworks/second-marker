            "f(x+y) = f(x) f(y)",
            "put x = 0, y = 5 : f(5) = f(0) f(5) ⇒ f(0) = 1",
            "f'(5) = lim_h→0 [f(5+h) - f(5)] / h",
            "= lim_h→0 [f(5) f(h) - f(5)] / h",
            "= lim_h→0 [2 f(h) - 2] / h",
            "= 2 lim_h→0 [f(h) - f(0)] / h",
            "= 2 f'(0) = 2 × 3",
            "∴ f'(5) = 6"
          ],
          "examinerMark": 2,
          "legible": true
        }
      ]
