{
  "name": "second-marker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "eval": "tsx --conditions=react-server --env-file=.env.local scripts/eval-reader.ts",
    "sample": "tsx --conditions=react-server --env-file=.env.local scripts/build-sample.ts",
    "sample:pages": "node scripts/sample/pages.mjs",
    "pdf-worker": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "predev": "npm run pdf-worker",
    "prebuild": "npm run pdf-worker"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
